<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="550"
        x:Class="C__projet.MainWindow"
        Title="SteganoLSB - Outil de Stéganographie">

    <TabControl>
        <TabItem Header="🏠 Accueil">
            <StackPanel Margin="30" Spacing="15">
                <TextBlock Text="Bienvenue sur SteganoLSB" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="SteelBlue"/>
                <Separator Height="2" Background="LightGray"/>
                <TextBlock Text="Cet outil utilise la méthode LSB (Least Significant Bit)." FontWeight="SemiBold"/>
                <TextBlock Text="Le principe : On modifie le bit de poids faible de chaque pixel. La modification est tellement petite qu'elle est invisible à l'œil nu." TextWrapping="Wrap" FontStyle="Italic"/>
                <TextBlock Text="Instructions :" FontWeight="Bold" Margin="0,10,0,0"/>
                <TextBlock Text="1. Allez dans l'onglet 'Encodage' pour cacher un message."/>
                <TextBlock Text="2. Utilisez l'onglet 'Décodage' pour lire une image traitée."/>
            </StackPanel>
        </TabItem>

        <TabItem Header="🔒 Encodage">
            <StackPanel Margin="20" Spacing="10">
                <TextBlock Text="Cacher un message" FontSize="18" FontWeight="Bold"/>
                <Button Name="BtnOuvrirEncodage" Content="📁 Choisir une image source" HorizontalAlignment="Stretch"/>
                <TextBox Name="InputMessage" Watermark="Tapez votre secret ici..." Height="60" AcceptsReturn="True" TextWrapping="Wrap"/>
                <Button Name="BtnLancerEncodage" Content="Lancer l'encodage" HorizontalAlignment="Stretch" Background="SteelBlue" Foreground="White"/>
                <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Height="150">
                     <Image Name="ImgPreview" Stretch="Uniform"/>
                </Border>
            </StackPanel>
        </TabItem>

        <TabItem Header="🔓 Décodage">
            <StackPanel Margin="20" Spacing="10">
                <TextBlock Text="Extraire un message" FontSize="18" FontWeight="Bold"/>
                <Button Name="BtnOuvrirDecodage" Content="📁 Sélectionner l'image cryptée" HorizontalAlignment="Stretch"/>
                <Button Name="BtnLancerDecodage" Content="🔎 Analyser les bits" HorizontalAlignment="Stretch" Background="MediumSeaGreen" Foreground="White"/>
                <TextBox Name="TxtResultat" IsReadOnly="True" Height="100" Watermark="Le secret apparaîtra ici..." TextWrapping="Wrap"/>
            </StackPanel>
        </TabItem>

        <TabItem Header="⚙️ Paramètres">
            <StackPanel Margin="20" Spacing="10">
                <TextBlock Text="Réglages de l'application" FontSize="18" FontWeight="Bold"/>
		<ToggleSwitch Name="ToggleTheme" Content="Mode Sombre" OffContent="Désactivé" OnContent="Activé"/>
                <TextBlock Text="Version du logiciel : 1.0.0" Foreground="Gray"/>
                <TextBlock Text="Auteurs : Votre Groupe" Foreground="Gray"/>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>